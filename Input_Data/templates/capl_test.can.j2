// bind gReq / gRespObj to the BCM-X1 diagnostic description (CDD/ODX) and run on a bench only.

variables
{
  diagRequest BCM_X1.* gReq;     // raw request object of the BCM-X1 diagnostic description
  diagResponse BCM_X1.* gRespObj;
  byte gResp[4095];
  long gRespLen;
}

byte HexVal(char c)
{
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return c - 'a' + 10;
}

// "22 F1 90" -> {0x22, 0xF1, 0x90}; returns the number of bytes
long HexToBytes(char hex[], byte out[])
{
  long i, n;
  n = 0;
  for (i = 0; i + 1 < strlen(hex); i += 3)
    out[n++] = (HexVal(hex[i]) << 4) | HexVal(hex[i + 1]);
  return n;
}

// Compares the last response with a pattern; "XX" matches any byte, "<none>" = no response
long MatchPattern(byte resp[], long len, char pattern[])
{
  long i, n;
  n = 0;
  for (i = 0; i + 1 < strlen(pattern); i += 3)
  {
    if (n >= len) return 0;
    if (pattern[i] != 'X' && resp[n] != ((HexVal(pattern[i]) << 4) | HexVal(pattern[i + 1]))) return 0;
    n++;
  }
  return n == len;
}

long SendBytes(byte req[], long len, char expected[])
{
  diagResize(gReq, len);
  diagSetPrimitiveData(gReq, req, len);
  diagSendRequest(gReq);
  if (testWaitForDiagResponse(gReq, 2000) != 1)
    return strncmp(expected, "<none>", 6) == 0;
  diagGetLastResponse(gReq, gRespObj);
  gRespLen = diagGetPrimitiveData(gRespObj, gResp, elcount(gResp));
  return MatchPattern(gResp, gRespLen, expected);
}

long SendAndCheck(char reqHex[], char expected[])
{
  byte req[4095];
  return SendBytes(req, HexToBytes(reqHex, req), expected);
}

// Demo OEM bench key algorithm (not secret): key = seed XOR constant, seed taken from the last 67 xx response
long SendKey(byte keySub, dword xorConstant, char expected[])
{
  byte req[6];
  dword key;
  key = ((dword)gResp[2] << 24 | (dword)gResp[3] << 16 | (dword)gResp[4] << 8 | gResp[5]) ^ xorConstant;
  req[0] = 0x27; req[1] = keySub;
  req[2] = (key >> 24) & 0xFF; req[3] = (key >> 16) & 0xFF; req[4] = (key >> 8) & 0xFF; req[5] = key & 0xFF;
  return SendBytes(req, 6, expected);
}
